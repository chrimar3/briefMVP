#!/usr/bin/env python3
"""Fake `claude` CLI for offline replay and for tests of the subprocess seam.

Select it with the existing override, never by changing pipeline/agents.py:

    BRIEF_BUILDER_CLAUDE_BIN=tools/replay/claude python3 pipeline/runner.py \
        --project fixtures/northlight_01 --out /tmp/bb-replay

Default behaviour: replay the recorded run's artifact for the work order (pipeline/replay.py).
Every flag it does not need is accepted and ignored. Test-only switches, read from the
environment so the command line stays exactly what agents.invoke built:

    BRIEF_BUILDER_FAKE_CLAUDE_MODE   empty | non_json | is_error | sleep:<seconds> | exit:<code>
    BRIEF_BUILDER_FAKE_CLAUDE_ARGV   file to write the received argv (JSON list) and cwd into

No network, no model, no cost.
"""
import json
import os
import sys
import time
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(REPO_ROOT))

from pipeline import replay  # noqa: E402


def main() -> int:
    argv_log = os.environ.get("BRIEF_BUILDER_FAKE_CLAUDE_ARGV")
    if argv_log:
        record = {"argv": sys.argv[1:], "cwd": os.getcwd()}
        Path(argv_log).write_text(json.dumps(record), encoding="utf-8")
    mode = os.environ.get("BRIEF_BUILDER_FAKE_CLAUDE_MODE", "")
    if mode == "empty":
        print("fake claude: no stdout on purpose", file=sys.stderr)
        return 1
    if mode == "non_json":
        print("this is not JSON")
        return 0
    if mode == "is_error":
        print(json.dumps(replay.cli_reply("fake", "simulated CLI error", is_error=True)))
        return 0
    if mode.startswith("sleep:"):
        time.sleep(float(mode.split(":", 1)[1]))
    if mode.startswith("exit:"):
        print(json.dumps(replay.cli_reply("fake", "simulated non-zero exit")))
        return int(mode.split(":", 1)[1])
    return replay.main(sys.argv[1:])


if __name__ == "__main__":
    raise SystemExit(main())
