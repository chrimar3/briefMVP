__pycache__/
*.py[cod]
.pytest_cache/
.venv/
# Toolchain byproducts of scripts/check.sh (coverage data, mypy and ruff caches).
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Run outputs are artifacts, not source. Tier reports and blockers are the exception:
# they are the record of the build and must survive in git.
runs/*
!runs/tier_*_report.md
!runs/design_audit_report.md
!runs/cost_c*_report.md
!runs/voreas_prep_report.md
!runs/BLOCKED.md

# The shareable shelf: distribution copies regenerated from runs/, never source.
# The README explaining the folder IS tracked.
reviews/*.html
reviews/*.md
!reviews/README.md

# macOS
.DS_Store

# Evidence pack: the graded Tier-3/4 run, committed so every claim in the tier
# reports is inspectable without re-running the pipeline (signed brief, renders,
# extracts, fidelity, harness verdict, creative A/B drafts).
!runs/tier3

# Walkthrough tooling: Codex run logs and gate byproducts are regenerated, never source.
tools/walkthrough/*.log
tools/walkthrough/_s*.js

# Evidence for tests/test_regression_voreas.py: the two Voreas prep runs (15/17 and 16/17) the
# documented content-integrity failures were found in; small, synthetic, read-only.
!runs/voreas-prep-02
!runs/voreas-prep-03

# Deterministic agency-lifecycle rehearsal (regenerate.py + transcript + records; zero model calls).
!runs/rehearsal-lifecycle

# Current-routing validation leg (one transcript: extract + verify-extract), 32 KB, synthetic;
# cited by docs/COST_MODEL.md, docs/EVAL_RECORD.md and README.md.
!runs/routing-validate-01

# Codex round runner: per-agent logs and scratch dirs are regenerated; results (out/, result.json, report.md) are kept.
tools/walkthrough/archive/codex_round/*/logs/
tools/walkthrough/archive/codex_round/*/work/
tools/walkthrough/archive/codex_round/*.log
tools/walkthrough/archive/redesign/*.log
tools/walkthrough/archive/redesign/chrome/
!runs/r2-live
runs/r2-live/latest
