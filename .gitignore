__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# Run outputs are artifacts, not source. Tier reports and blockers are the exception:
# they are the record of the build and must survive in git.
runs/*
!runs/tier_*_report.md
!runs/design_audit_report.md
!runs/cost_c*_report.md
!runs/voreas_prep_report.md
!runs/BLOCKED.md

# The shareable shelf: distribution copies regenerated from runs/, never source.
# The README explaining the folder IS tracked.
reviews/*.html

# macOS
.DS_Store

# Evidence pack: the graded Tier-3/4 run, committed so every claim in the tier
# reports is inspectable without re-running the pipeline (signed brief, renders,
# extracts, fidelity, harness verdict, creative A/B drafts).
!runs/tier3
