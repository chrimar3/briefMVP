{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Northlight Client Brief — canonical, language-neutral form (PRD DR-6: one-way door)",
  "description": "The single source of truth a brief exists as. GR and EN renders are generated FROM this object (generate once, render twice); nothing may appear in a render that is not in this object. Canonical 'content' is written in English as the pivot language, with glossary-protected terms preserved character-exact; TRANSLATION.md governs rendering. Frozen after Tier-0 human approval.",
  "type": "object",
  "required": [
    "meta",
    "objectives",
    "audiences",
    "key_messages",
    "deliverables",
    "timeline",
    "budget",
    "mandatories",
    "open_questions",
    "conflicts",
    "readiness",
    "signoff"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "project_id",
        "client_id",
        "project_type",
        "classification_confidence",
        "sensitivity_tier",
        "sources",
        "created_ts",
        "pipeline_version"
      ],
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string"
        },
        "client_id": {
          "type": "string"
        },
        "project_type": {
          "type": "string",
          "enum": [
            "advertising_creative",
            "other",
            "unclassified_ask_human"
          ]
        },
        "classification_confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "sensitivity_tier": {
          "type": "string",
          "enum": [
            "S0",
            "S1"
          ],
          "description": "S2/S3 intentionally NOT valid in v1 — scope enforcement lives in the schema itself (PRD DR-11)."
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "source_id",
              "source_type",
              "source_date"
            ],
            "additionalProperties": false,
            "properties": {
              "source_id": {
                "type": "string"
              },
              "source_type": {
                "type": "string",
                "enum": [
                  "transcript",
                  "rfp",
                  "email_thread",
                  "background"
                ]
              },
              "source_date": {
                "type": "string"
              }
            }
          }
        },
        "created_ts": {
          "type": "string"
        },
        "pipeline_version": {
          "type": "string"
        }
      }
    },
    "objectives": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/brief_entry"
      }
    },
    "audiences": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/brief_entry"
      }
    },
    "key_messages": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/brief_entry"
      }
    },
    "deliverables": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/brief_entry"
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/brief_entry"
      }
    },
    "budget": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/brief_entry"
      }
    },
    "mandatories": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/brief_entry"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "field",
          "gap",
          "why_it_matters",
          "suggested_question_for_client"
        ],
        "additionalProperties": false,
        "properties": {
          "field": {
            "type": "string"
          },
          "gap": {
            "type": "string"
          },
          "why_it_matters": {
            "type": "string"
          },
          "suggested_question_for_client": {
            "type": "string"
          },
          "linked_evidence": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/evidence_ref"
            }
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "field",
          "positions",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "field": {
            "type": "string"
          },
          "positions": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": [
                "statement",
                "evidence"
              ],
              "additionalProperties": false,
              "properties": {
                "statement": {
                  "type": "string"
                },
                "evidence": {
                  "$ref": "#/definitions/evidence_ref"
                }
              }
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "resolved_by_human"
            ]
          },
          "resolution": {
            "type": "string"
          },
          "resolved_by": {
            "type": "string"
          }
        }
      }
    },
    "readiness": {
      "type": "object",
      "description": "Deterministic input-coverage verdict computed by the runner — never by a model. Thin input must be labeled at the exit, not disguised as a finished brief.",
      "required": [
        "fields_with_evidence",
        "low_confidence_share",
        "open_question_count",
        "verdict"
      ],
      "additionalProperties": false,
      "properties": {
        "fields_with_evidence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "low_confidence_share": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "open_question_count": {
          "type": "integer",
          "minimum": 0
        },
        "verdict": {
          "type": "string",
          "enum": [
            "ready_for_review",
            "thin_input_return_to_client"
          ]
        }
      }
    },
    "signoff": {
      "type": "object",
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "signed_off"
          ]
        },
        "signed_by": {
          "type": "string"
        },
        "signed_ts": {
          "type": "string"
        },
        "edits_summary": {
          "type": "string",
          "description": "What the human changed — feeds the draft-survival metric."
        }
      }
    }
  },
  "definitions": {
    "evidence_ref": {
      "type": "object",
      "required": [
        "source_id",
        "location",
        "anchor",
        "speaker_or_author"
      ],
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "anchor": {
          "type": "string"
        },
        "speaker_or_author": {
          "type": "string"
        }
      }
    },
    "brief_entry": {
      "type": "object",
      "required": [
        "content",
        "evidence",
        "confidence",
        "qualifier"
      ],
      "additionalProperties": false,
      "properties": {
        "content": {
          "type": "string",
          "description": "Canonical statement (EN pivot; glossary terms character-exact). Faithful to evidence — no invention, no resolution of conflicts."
        },
        "original_lang": {
          "type": "string",
          "enum": [
            "el",
            "en",
            "mixed"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/evidence_ref"
          }
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "qualifier": {
          "type": "string",
          "enum": [
            "stated",
            "implied",
            "conditional"
          ]
        }
      }
    }
  }
}